{
  "name": "ulmc-cms",
  "version": "1.0.0",
  "private": true,
  "description": "University of Liberia \u2014 Department of Communication and Media Studies: academic site, newsroom, editorial workflow and analytics.",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:worker": "tsx --env-file=.env watch src/worker/index.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "tsx --env-file=.env scripts/reset.ts",
    "db:pg:start": "pg_ctl -D .pgdata -o \"-p 5433 -k /tmp\" -l .pgdata/server.log start || true",
    "db:pg:stop": "pg_ctl -D .pgdata stop || true",
    "setup": "tsx --env-file=.env scripts/setup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
