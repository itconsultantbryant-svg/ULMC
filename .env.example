# ---------------------------------------------------------------------------
# The Varsity Pilot — Department of Communication and Media Studies, University of Liberia
# Copy to .env (never commit .env). All values below are descriptions; provide
# real values per environment. No production secrets belong in this file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the app and worker.
# Example: postgres://postgres:postgres@localhost:5433/ulmc_dev
DATABASE_URL="postgres://postgres:postgres@localhost:5433/ulmc_dev"

# Public origin of the site (no trailing slash). Used for canonical URLs,
# sitemaps, auth callbacks and share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth configuration. Generate a secret with:
#   openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-48-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Additional origins permitted to sign in to the same deployment, comma-separated.
BETTER_AUTH_TRUSTED_ORIGINS=""

# Default institutional display name. Administrators can override this in
# Studio > Settings (stored in the database, which takes precedence).
SITE_NAME="The Varsity Pilot"

# Email delivery: "console" logs messages (development), "smtp" sends through
# the SMTP settings below.
EMAIL_DRIVER="console"
EMAIL_FROM="The Varsity Pilot <masscommdept@ul.edu.lr>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Media storage: "local" writes to .data/uploads (served through an authorised
# route), "s3" uses any S3-compatible bucket.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# Optional CDN/public base URL for public derivatives (S3 driver only).
S3_PUBLIC_BASE_URL=""

# Secret used to sign short-lived private media and preview tokens.
# Generate with: openssl rand -base64 48
MEDIA_SIGNING_SECRET="replace-with-another-random-secret"

# Worker / scheduler cadence.
WORKER_POLL_MS="2000"
WORKER_ID="worker-1"

# Analytics.
ANALYTICS_ACTIVE_WINDOW_MINUTES="5"
ANALYTICS_RETENTION_DAYS="180"
# Set true only for demo environments. Demo events are labelled in the UI and
# excluded from production reporting.
ENABLE_ANALYTICS_DEMO="false"

# One-time setup token for the first super administrator. Generate with:
#   openssl rand -hex 24
# Visit /setup?token=... once, then remove this value.
SETUP_TOKEN=""

# Optional shared secret for an external cron hitting /api/internal/tick
# (only needed when the long-running worker is not deployed).
CRON_SECRET=""
